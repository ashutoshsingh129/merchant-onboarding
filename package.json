{
  "name": "merchant-onboarding-app",
  "version": "1.0.0",
  "description": "Full-stack merchant onboarding application with Stripe integration",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "start": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "start:server": "cd server && npm run dev",
    "start:client": "cd client && npm start",
    "start:server:prod": "cd server && npm start",
    "start:client:prod": "cd client && npm start",
    "build": "cd client && npm run build",
    "dev": "concurrently \"npm run start:server\" \"npm run start:client\"",
    "setup": "npm run install:all"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "stripe",
    "merchant",
    "onboarding",
    "react",
    "express",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}